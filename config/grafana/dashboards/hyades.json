   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(slurm_user_state_total{state=\"RUNNING\"}) or vector(0)",
     "legendFormat": "ejecutándose",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
